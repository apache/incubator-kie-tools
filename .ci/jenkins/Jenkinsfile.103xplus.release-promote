@Library('jenkins-pipeline-shared-libraries')_

// 10.3.x+ promote / tag-release pipeline for incubator-kie-tools.
// Run after the IPMC vote passes to:
//   1. Create and push the official release Git tag (e.g. 10.3.0) pointing to the approved RC commit.
//   2. Create the GitHub Release for incubator-kie-tools (required before release-publish).
//   3. Move the approved RC in Apache SVN from dist/dev to dist/release, and delete the other RCs of the release.

pipeline {
    agent {
        label util.avoidFaultyNodes()
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'RELEASE_VERSION',
            description: 'Release version (e.g., 10.3.0)',
            defaultValue: ''
        )
        string(
            name: 'BASE_REF',
            description: 'Approved RC tag (e.g. 10.3.0-rc1) to tag from',
            defaultValue: ''
        )
    }

    stages {
        stage('Validate parameters') {
            steps {
                script {
                    if (params.RELEASE_VERSION == '') {
                        error("RELEASE_VERSION is required (e.g. 10.3.0)")
                    }
                    if (params.BASE_REF == '') {
                        error("BASE_REF (approved RC tag, e.g. 10.3.0-rc1) is required")
                    }
                    if (!params.BASE_REF.startsWith("${params.RELEASE_VERSION}-rc")) {
                        error("BASE_REF '${params.BASE_REF}' must be an RC tag for RELEASE_VERSION '${params.RELEASE_VERSION}' (e.g. ${params.RELEASE_VERSION}-rc1)")
                    }
                    currentBuild.displayName = "${params.RELEASE_VERSION} (${params.BASE_REF})"
                }
            }
        }

        stage('Load local shared scripts') {
            steps {
                script {
                    pipelineVars = load '.ci/jenkins/shared-scripts/pipelineVars.groovy'
                    githubUtils = load '.ci/jenkins/shared-scripts/githubUtils.groovy'
                    releaseUtils = load '.ci/jenkins/shared-scripts/releaseUtils.groovy'
                }
            }
        }

        stage('Clean workspace') {
            steps {
                cleanWs(deleteDirs: true, disableDeferredWipeout: true)
            }
        }

        stage('Checkout incubator-kie-tools') {
            steps {
                dir('kie-tools') {
                    script {
                        githubUtils.checkoutRepo(
                            "https://github.com/${pipelineVars.githubRepositorySlug}.git",
                            "${params.BASE_REF}",
                            "${pipelineVars.asfGithubPushCredentialsId}"
                        )
                    }
                }
            }
        }

        stage('Tag final release') {
            steps {
                dir('kie-tools') {
                    script {
                        withCredentials([
                            usernamePassword(credentialsId: "${pipelineVars.asfGithubPushCredentialsId}", usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')
                        ]) {
                            sh """#!/bin/bash -el
                            set -euo pipefail
                            git config user.email "dev@kie.apache.org"
                            git config user.name  "Apache KIE Release Bot"
                            git config --local credential.helper '!f() { echo username=\$GITHUB_USER; echo password=\$GITHUB_TOKEN; }; f'

                            # Fetch the approved RC tag
                            git fetch origin "refs/tags/${params.BASE_REF}:refs/tags/${params.BASE_REF}"

                            # Create and push the final release tag pointing to the RC commit.
                            # If a previous run already pushed it (e.g. it failed in a later stage), reuse it.
                            if git ls-remote --exit-code --tags origin "refs/tags/${params.RELEASE_VERSION}" >/dev/null 2>&1; then
                                echo "Tag ${params.RELEASE_VERSION} already exists on origin, skipping tag creation"
                            else
                                git tag -a "${params.RELEASE_VERSION}" "${params.BASE_REF}" -m "Release ${params.RELEASE_VERSION}"
                                git push origin "${params.RELEASE_VERSION}"
                            fi
                            """
                        }
                    }
                }
            }
        }

        stage('Create GitHub Release') {
            steps {
                dir('kie-tools') {
                    script {
                        withCredentials([
                            string(credentialsId: "${pipelineVars.kieToolsBotGithubTokenCredentialsId}", variable: 'GITHUB_TOKEN')
                        ]) {
                            sh """#!/bin/bash -el
                            set -euo pipefail

                            FINAL_TAG="${params.RELEASE_VERSION}"

                            # Delete any pre-existing release for this tag if needed
                            if gh release view "\${FINAL_TAG}" --repo "${pipelineVars.githubRepositorySlug}" &>/dev/null; then
                                gh release delete "\${FINAL_TAG}" --repo "${pipelineVars.githubRepositorySlug}" --yes
                            fi

                            # Fetch tags to identify previous release tag for changelog generation
                            git fetch --tags origin

                            PREV_TAG="\$(git tag -l --sort=-version:refname | grep -v -- '-rc' | awk -v target="\${FINAL_TAG}" '
                                BEGIN { found = 0 }
                                {
                                    if (\$0 == target) {
                                        found = 1
                                        next
                                    }
                                    if (found) {
                                        print \$0
                                        exit
                                    }
                                }
                            ' || true)"
                            if [[ -z "\${PREV_TAG}" ]]; then
                                PREV_TAG="\$(git tag -l --sort=-version:refname | grep -v -- '-rc' | grep -v "^\${FINAL_TAG}\$" | head -1 || true)"
                            fi

                            gh release create "\${FINAL_TAG}" \
                                --repo "${pipelineVars.githubRepositorySlug}" \
                                --title "\${FINAL_TAG}" \
                                --verify-tag \
                                --generate-notes \
                                \${PREV_TAG:+--notes-start-tag "\${PREV_TAG}"}
                            """
                        }
                    }
                }
            }
        }

        stage('Promote artifacts in Apache SVN') {
            steps {
                script {
                    releaseUtils.promoteArtifacts(
                        "${pipelineVars.asfReleaseStagingRepository}",
                        "${pipelineVars.asfReleaseRepository}",
                        "${params.RELEASE_VERSION}",
                        "${params.BASE_REF}",
                        "${pipelineVars.asfReleaseSVNStagingCredentialsId}"
                    )
                }
            }
        }
    }

    post {
        cleanup {
            cleanWs()
        }
    }
}
