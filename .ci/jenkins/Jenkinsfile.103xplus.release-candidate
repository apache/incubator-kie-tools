@Library('jenkins-pipeline-shared-libraries')_

// PHASE 1: Create Release Candidate for Apache Voting
// This job builds artifacts, signs them, and publishes to Apache SVN for community vote
// Does NOT publish to npm, VSCode Marketplace, or Chrome Web Store
//
// NOTE: kogito-data-index-ephemeral is NOT included in this pipeline because the
// packages/kogito-data-index-ephemeral-image package no longer exists in this repo.
// Its presence in older Jenkinsfiles (Jenkinsfile.release-candidate RUNNERS list and
// release-jobs/Jenkinsfile.kogito-data-index-ephemeral-image) is a historical artifact
// from pre-10.3 automation and can be cleaned up in a follow-up PR.

pipeline {
    agent {
        docker {
            image 'docker.io/apache/incubator-kie-tools-ci-build:main'
            args '--shm-size=2g --privileged --group-add docker'
            label util.avoidFaultyNodes()
        }
    }

    options {
        timeout(time: 480, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'RELEASE_VERSION',
            description: 'MANDATORY. Exact release version, e.g. 10.3.0',
            defaultValue: '0.0.0'
        )
        string(
            name: 'TAG_NAME',
            description: 'MANDATORY. RC tag name, e.g. 10.3.0-rc1 (must start with RELEASE_VERSION and be a new tag)',
            defaultValue: '0.0.0-rc1'
        )
        booleanParam(
            name: 'CREATE_STREAM_BRANCH',
            description: 'Branch cut, part 1: create branch X.Y.x (derived from RELEASE_VERSION) from main and push it. Only for the first RC of a new minor (e.g. 10.3.0-rc1). Fails if X.Y.x already exists',
            defaultValue: false
        )
        booleanParam(
            name: 'UPDATE_STREAM_VERSION',
            description: 'Branch cut, part 2: set the development version in all files on X.Y.x (project version X.Y.999, kogito maven X.Y.999-SNAPSHOT, stream name X.Y.x), commit and push. Use together with CREATE_STREAM_BRANCH for a normal branch cut, or alone if X.Y.x was already created',
            defaultValue: false
        )
        booleanParam(
            name: 'UPDATE_CI_IMAGE_TAG',
            description: 'Only used with UPDATE_STREAM_VERSION=true. Also point every Jenkinsfile at docker.io/apache/incubator-kie-tools-ci-build:X.Y.999 (as done for 10.2.x). Enable ONLY if that image tag has already been built and pushed; otherwise jobs on the new branch cannot start',
            defaultValue: false
        )
    }

    environment {
        KIE_TOOLS_BUILD__runLinters = 'false'
        KIE_TOOLS_BUILD__runTests = 'false'
        KIE_TOOLS_BUILD__runEndToEndTests = 'false'
        KIE_TOOLS_BUILD__buildContainerImages = 'true'

        CHROME_EXTENSION__routerTargetOrigin = 'https://apache.github.io'
        CHROME_EXTENSION__routerRelativePath = "incubator-kie-kogito-online/chrome-extension/${params.RELEASE_VERSION}"
        CHROME_EXTENSION__manifestFile = 'manifest.prod.json'
        CHROME_EXTENSION__onlineEditorUrl = 'https://apache.github.io/incubator-kie-kogito-online'

        ONLINE_EDITOR__corsProxyUrl = 'https://cors-proxy-kie-sandbox.rhba-0ad6762cc85bcef5745bb684498c2436-0000.us-south.containers.appdomain.cloud'
        ONLINE_EDITOR__buildInfo = "${params.RELEASE_VERSION}"
        ONLINE_EDITOR__extendedServicesCompatibleVersion = "${params.RELEASE_VERSION}"
        ONLINE_EDITOR__devDeploymentBaseImageRegistry = 'docker.io'
        ONLINE_EDITOR__devDeploymentBaseImageAccount = 'apache'
        ONLINE_EDITOR__devDeploymentBaseImageName = 'incubator-kie-sandbox-dev-deployment-base'
        ONLINE_EDITOR__devDeploymentBaseImageTag = "${params.RELEASE_VERSION}"
        ONLINE_EDITOR__devDeploymentDmnFormWebappImageRegistry = 'docker.io'
        ONLINE_EDITOR__devDeploymentDmnFormWebappImageAccount = 'apache'
        ONLINE_EDITOR__devDeploymentDmnFormWebappImageName = 'incubator-kie-sandbox-dev-deployment-dmn-form-webapp'
        ONLINE_EDITOR__devDeploymentDmnFormWebappImageTag = "${params.RELEASE_VERSION}"
        ONLINE_EDITOR__devDeploymentQuarkusBlankAppImageRegistry = 'docker.io'
        ONLINE_EDITOR__devDeploymentQuarkusBlankAppImageAccount = 'apache'
        ONLINE_EDITOR__devDeploymentQuarkusBlankAppImageName = 'incubator-kie-sandbox-dev-deployment-quarkus-blank-app'
        ONLINE_EDITOR__devDeploymentQuarkusBlankAppImageTag = "${params.RELEASE_VERSION}"
    }

    stages {
        stage('Load local shared scripts') {
            steps {
                script {
                    pipelineVars = load '.ci/jenkins/shared-scripts/pipelineVars.groovy'
                    buildUtils = load '.ci/jenkins/shared-scripts/buildUtils.groovy'
                    githubUtils = load '.ci/jenkins/shared-scripts/githubUtils.groovy'
                    releaseUtils = load '.ci/jenkins/shared-scripts/releaseUtils.groovy'
                }
            }
        }

        // The stream branch X.Y.x is derived from RELEASE_VERSION. A branch cut starts from main;
        // every other run (rc2, patch releases) builds from the existing X.Y.x.
        stage('Resolve release ref') {
            steps {
                script {
                    def m = (params.RELEASE_VERSION =~ /^(\d+)\.(\d+)\..+$/)
                    if (!m.matches()) {
                        error("Cannot derive stream branch from RELEASE_VERSION '${params.RELEASE_VERSION}' (expected e.g. 10.3.0)")
                    }
                    streamBranch = "${m.group(1)}.${m.group(2)}.x"
                    devVersion = "${m.group(1)}.${m.group(2)}.999"
                    m = null

                    if (!params.TAG_NAME.startsWith(params.RELEASE_VERSION)) {
                        error("TAG_NAME '${params.TAG_NAME}' must start with RELEASE_VERSION '${params.RELEASE_VERSION}'")
                    }
                    baseRef = params.CREATE_STREAM_BRANCH ? 'main' : streamBranch
                    echo "Building from ${baseRef}"
                }
            }
        }

        stage('Start required services') {
            steps {
                script {
                    buildUtils.startRequiredServices()
                }
            }
        }

        stage('Clean workspace') {
            steps {
                cleanWs(deleteDirs: true, disableDeferredWipeout: true)
            }
        }

        stage('Checkout kie-tools') {
            steps {
                dir('kie-tools') {
                    script {
                        githubUtils.checkoutRepo(
                            "http://github.com/${pipelineVars.githubRepositorySlug}.git",
                            "${baseRef}",
                            "${pipelineVars.kieToolsBotGithubCredentialsId}"
                        )
                    }
                }
            }
        }

        stage('Setup PNPM') {
            steps {
                dir('kie-tools') {
                    script {
                        buildUtils.setupPnpm("${pipelineVars.mavenSettingsReleaseConfigFileId}")
                    }
                }
            }
        }

        stage('Setup Git repository') {
            steps {
                dir('kie-tools') {
                    script {
                        sh """#!/bin/bash -el
                        git config user.email asf-ci-kie@jenkins.kie.apache.org
                        git config user.name asf-ci-kie
                        git checkout ${baseRef}
                        """.trim()
                    }
                }
            }
        }

        stage('Bootstrap') {
            steps {
                dir('kie-tools') {
                    sh '''#!/bin/bash -el
                    pnpm bootstrap
                    '''
                }
            }
        }

        stage('Create stream branch') {
            when {
                expression { return params.CREATE_STREAM_BRANCH || params.UPDATE_STREAM_VERSION }
            }
            steps {
                dir('kie-tools') {
                    script {
                        // Part 1: create the branch from main (the checkout above is already on the
                        // existing X.Y.x when only UPDATE_STREAM_VERSION is set)
                        if (params.CREATE_STREAM_BRANCH) {
                            def exists = sh(
                                returnStatus: true,
                                script: "git ls-remote --exit-code --heads origin ${streamBranch} > /dev/null"
                            ) == 0
                            if (exists) {
                                error("Branch '${streamBranch}' already exists on origin. The branch cut is done once per minor; unset CREATE_STREAM_BRANCH for rc2 / patch releases.")
                            }
                            withEnv(["STREAM_BRANCH=${streamBranch}"]) {
                                sh '''#!/bin/bash -el
                                git checkout -b "$STREAM_BRANCH"
                                '''
                            }
                        }

                        // Part 2: update the version in all files
                        // Same set of changes as the 10.2.x branch cut (Jenkinsfile.setup-branch):
                        // project version, kogito maven version, stream name (+ optional CI image tag).
                        if (params.UPDATE_STREAM_VERSION) {
                            withEnv(["DEV_VERSION=${devVersion}", "DEV_MAVEN_VERSION=${devVersion}-SNAPSHOT", "STREAM_BRANCH=${streamBranch}", "UPDATE_CI_IMAGE_TAG=${params.UPDATE_CI_IMAGE_TAG}"]) {
                                sh '''#!/bin/bash -el
                                pnpm update-version-to "$DEV_VERSION"
                                pnpm update-kogito-version-to --maven "$DEV_MAVEN_VERSION"
                                pnpm update-stream-name-to "$STREAM_BRANCH"
                                if [ "$UPDATE_CI_IMAGE_TAG" = "true" ]; then
                                  find .ci/jenkins -type f -name 'Jenkinsfile.*' -exec sed -E -i "s%(incubator-kie-tools-ci-build:)(main|[$][{]env[.]BRANCH_NAME[}])%\\1${DEV_VERSION}%g" {} +
                                fi
                                git add .
                                git commit --allow-empty -am "Update development version to $DEV_VERSION"
                                '''
                            }
                        }

                        githubUtils.pushObject('origin', streamBranch, "${pipelineVars.asfGithubPushCredentialsId}")
                    }
                }
            }
        }

        stage('Update versions') {
            steps {
                dir('kie-tools') {
                    sh """#!/bin/bash -el
                    pnpm update-version-to ${params.RELEASE_VERSION}
                    pnpm update-kogito-version-to --maven ${params.RELEASE_VERSION}
                    pnpm update-stream-name-to ${params.RELEASE_VERSION}
                    """
                }
            }
        }

        stage('Commit changes') {
            steps {
                dir('kie-tools') {
                    script {
                        sh """#!/bin/bash -el
                        git add .
                        git commit --allow-empty -am "Apache KIE ${params.RELEASE_VERSION} release candidate ${params.TAG_NAME}"
                        """.trim()
                    }
                }
            }
        }

        stage('Check release version against package.json') {
            steps {
                dir('kie-tools') {
                    script {
                        def packageVersion = sh(
                            returnStdout: true,
                            script: "#!/bin/bash -el \n node -p \"require('./package.json').version\""
                        ).trim()
                        if (packageVersion != params.RELEASE_VERSION) {
                            error("Version mismatch! package.json has ${packageVersion} but RELEASE_VERSION is ${params.RELEASE_VERSION}")
                        }
                    }
                }
            }
        }

        stage('Create and push RC tag') {
            steps {
                dir('kie-tools') {
                    script {
                        githubUtils.createTag("${params.TAG_NAME}")
                        githubUtils.pushObject('origin', "${params.TAG_NAME}", "${pipelineVars.asfGithubPushCredentialsId}")
                        sleep(time: 1, unit: 'MINUTES')
                    }
                }
            }
        }

        stage('Build Release Candidate Artifacts') {
            steps {
                dir('kie-tools') {
                    script {
                        echo "Building release candidate artifacts..."
                        echo "Version: ${params.RELEASE_VERSION}"
                        echo "RC: ${params.TAG_NAME}"

                        // Build artifacts WITHOUT publishing (no --publish flag)
                        // The --rc flag creates artifacts for Apache SVN
                        sh """#!/bin/bash -el
                        ./scripts/release/release-all.sh ${params.RELEASE_VERSION} --rc --git-ref ${params.TAG_NAME}
                        """
                    }
                }
            }
        }

        stage('Sign Release Candidate Artifacts') {
            steps {
                dir('kie-tools/release-artifacts') {
                    script {
                        releaseUtils.setupSigningKey("${pipelineVars.asfReleaseGPGKeyCredentialsId}")
                        
                        sh """#!/bin/bash -el
                        echo "Signing all artifacts..."
                        for file in *.zip *.vsix *.tar.gz; do
                            if [ -f "\$file" ]; then
                                echo "Signing \$file"
                                gpg --no-tty --batch --sign --pinentry-mode loopback --output "\$file.asc" --detach-sig "\$file"
                                shasum -a 512 "\$file" > "\$file.sha512"
                            fi
                        done

                        echo "Artifacts signed:"
                        ls -lh
                        """
                    }
                }
            }
        }

        stage('Publish to Apache SVN (for voting)') {
            steps {
                dir('kie-tools/release-artifacts') {
                    script {
                        echo "Publishing to Apache SVN staging repository..."
                        echo "Repository: ${pipelineVars.asfReleaseStagingRepository}"
                        echo "RC Version: ${params.TAG_NAME}"
                        
                        releaseUtils.publishArtifacts(
                            "${WORKSPACE}/kie-tools/release-artifacts",
                            "${pipelineVars.asfReleaseStagingRepository}",
                            "${params.TAG_NAME}",
                            "${pipelineVars.asfReleaseSVNStagingCredentialsId}"
                        )
                        
                        echo "✅ Release candidate published to:"
                        echo "   ${pipelineVars.asfReleaseStagingRepository}/${params.TAG_NAME}/"
                    }
                }
            }
        }
    }

    post {
        success {
            echo "=========================================="
            echo "✅ Release Candidate Created Successfully!"
            echo "=========================================="
            echo "Version: ${params.RELEASE_VERSION}"
            echo "RC: ${params.TAG_NAME}"
            echo ""
            echo "Artifacts published to:"
            echo "${pipelineVars.asfReleaseStagingRepository}/${params.TAG_NAME}/"
            echo ""
            echo "Next steps:"
            echo "1. Start a vote thread on dev@kie.apache.org"
            echo "2. Wait for vote to pass (72 hours, 3 +1 votes)"
            echo "3. Run Jenkinsfile.103xplus.release-publish to publish to registries"
            echo "=========================================="
        }
        failure {
            echo "❌ Release candidate creation failed!"
        }
        always {
            cleanWs(deleteDirs: true)
        }
    }
}